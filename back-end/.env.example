NODE_ENV=development
PORT=3333

# Serviço FastAPI que será implementado separadamente
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_SERVICE_TOKEN=
FASTAPI_TIMEOUT_MS=10000
FASTAPI_RETRY_ATTEMPTS=1

# Cache local em memória
CACHE_MAX_ENTRIES=500
CACHE_MAX_VALUE_BYTES=2097152
CACHE_MAX_TOTAL_BYTES=134217728
CACHE_CLEANUP_INTERVAL_SECONDS=60
CACHE_TTL_MUNICIPAL_PROCUREMENTS_SECONDS=1800
CACHE_TTL_LOCAL_ME_PARTICIPATION_SECONDS=21600
CACHE_TTL_ME_PROCUREMENTS_SECONDS=1800
CACHE_TTL_COMPANY_PROCUREMENTS_SECONDS=3600
CACHE_TTL_PROCUREMENT_CONTRACTS_SECONDS=21600

# API HTTP
DOCUMENTATION_ENABLED=true
CORS_ORIGINS=http://localhost:3000
THROTTLE_LIMIT=60
THROTTLE_TTL_MS=60000
